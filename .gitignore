# ============================================================
# 说明：本文件位于仓库根目录 ROS2/，下面的规则同时作用于
#       仓库内所有子文件夹（build/ 这类写法会自动匹配任意层级）。
#       以 / 开头的规则只匹配仓库根目录，无 / 的匹配任意层级。
# ============================================================

# ========== 1. AI 助手 / 编辑器缓存（每人本地不同，不上传）==========
.workbuddy/
.claude/
.cursor/
.aider*
*.genie
# Obsidian 配置目录：默认整体忽略；若要保留插件/主题配置，
# 可把下面这行改成 .obsidian/* 并配合 !.obsidian/plugins/ 之类的反忽略规则
.obsidian/

# ========== 2. ROS 2 / colcon 构建产物 ==========
# 任意层级的构建、安装、日志目录
build/
install/
log/

# colcon 生成的标记文件
.colcon_install_layout
.built_by
COLCON_IGNORE

# 运行 / 调试产生的文件
.ros/
*.log
*.bag
*.db3
*.db3-shm
*.db3-wal
*.yaml.bak

# ========== 3. Python ==========
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
*.whl
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
pip-wheel-metadata/

# 虚拟环境
venv/
.venv/
env/
ENV/

# ========== 4. CMake / C / C++ ==========
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CTestTestfile.cmake
CTestConfiguration.ini
CTestCustom.cmake
cmake-build-*/
compile_commands.json
*.cmake.in.stamp
*.sh.stamp

# 编译中间产物与库文件
*.o
*.o.d
*.obj
*.lo
*.so
*.a
*.out
*.dSYM/

# ========== 5. IDE / 编辑器 ==========
.vscode/
.idea/
.clangd/
.cache/
.project
.cproject
.settings/
*.code-workspace
*.swp
*.swo
*~

# ========== 6. 操作系统 ==========
.DS_Store
Thumbs.db
desktop.ini

# ========== 7. 个人临时 / 备份文件 ==========
*.bak
*.tmp
*.temp
*_backup_*
*.orig
*.rej
